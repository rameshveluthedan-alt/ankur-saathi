# ============================================================================================================================
# Ankur Saathi: environment settings.   Copy this file to backend/.env and fill in the THREE that matter (marked >>>).
#     cp backend/.env.example backend/.env          (Windows PowerShell:  Copy-Item backend\.env.example backend\.env)
# The scripts read the same file:  python scripts/<name>.py --env-file backend/.env
# NEVER commit .env (it is git-ignored). A line starting with # shows the DEFAULT: remove the # only to change it.
# Every variable the code reads is listed here (scripts/submission_check.py fails if one is missing).
# ============================================================================================================================

# ---- 1. DATABASE (PostgreSQL 14 or newer) ----------------------------------------------------------------------------------
# Either one URL (the password may not contain @ : / # here) ...
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/ankur_saathi
# ... or the parts below (the password may contain any character: it is encoded for you).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# >>> the password of your PostgreSQL user
DB_PASSWORD=
DB_NAME=ankur_saathi
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# ---- 2. THE AI (Anthropic Claude: the only AI service the running app calls) -----------------------------------------------
# >>> your Anthropic API key. Read on the SERVER only; never sent to the browser. Without it the app runs but cannot generate plans or read photos.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_VISION_MODEL=claude-sonnet-5-5
# A plan is about 11,000 to 13,000 output tokens. Below 16000 plans are CUT OFF and fail.
CLAUDE_MAX_TOKENS=24000
# AI_ENABLED=false makes no AI call at all; the recorded sample plans (six skills: N0.1.1, N2.2.1, N2.3.2, L2.3.1, L2.5.1, L2.7.2) are still served.
# AI_ENABLED=true

# ---- 3. SIGN-IN (docs/AUTH.md) ---------------------------------------------------------------------------------------------
# >>> only when DEBUG=false (a real deployment): a long random string. Changing it signs everyone out.
SESSION_SECRET=
DEBUG=true
# "enforce" for everything real. "off" exists only so automated tests of other features can skip sign-in.
# AUTH_MODE=enforce
# SESSION_HOURS=12
# PIN_HASH_ITERATIONS=600000
# Accounts are made by the school leader or loaded by the department. Leave self-registration off; true only on a practice database.
# SELF_REGISTRATION=false
# The browser origins allowed to call the API (a JSON list).
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://*.ankursaathi.in"]

# ---- 4. AI SPENDING LIMITS (docs/AI_BUDGET.md): every call is metered and capped so the credits last ------------------------
# AI_ALLOCATION_USD=500.0
# AI_SPEND_OFFSET_USD=3.0
# AI_CREDIT_EXPIRES=2026-11-20
# AI_RESERVE_USD=250.0
# AI_RESERVE_FROM=2026-11-01
# AI_FINAL_MARGIN_USD=10.0
# AI_CAP_GLOBAL_DAILY_USD=20.0
# AI_CAP_SCHOOL_DAILY_USD=10.0
# AI_CAP_TEACHER_DAILY_USD=3.0
# AI_CAP_SHARED_DEMO_DAILY_USD=8.0
# AI_PRICE_INPUT_PER_MTOK=2.0
# AI_PRICE_OUTPUT_PER_MTOK=10.0
# AI_TIMEZONE=Asia/Kolkata
# Where the recorded sample plans are (default db/seeds/sample_plans).
# SAMPLE_PLANS_DIR=

# ---- 5. HOW A PLAN IS MADE --------------------------------------------------------------------------------------------------
# Check-for-understanding "show-me" questions in every lesson (docs/CFU.md).
# CFU_ENABLED=true
# The extra short model call that replaces dropped show-me questions. 0 = off (a plan then has fewer questions, one call less).
# CFU_TOPUP=1
# The curated skill bridges (docs/BRIDGES.md). off = the prerequisite graph alone decides.
# SKILL_BRIDGES=on
# Where the curated anchors have nothing for a skill, choose the anchor nearest in meaning (docs/SEMANTIC_RETRIEVAL.md).
# The running app calls NO embedding service: the vectors are computed offline and loaded from a file. OFF until evaluated.
SEMANTIC_RETRIEVAL=off
# The state whose weekly curriculum is looked up.
# DEFAULT_STATE_ID=mp
# ANCHOR_DURATION_MINUTES=10
# SETUP_DURATION_MINUTES=2
# RETEACH_DURATION_MINUTES=5
# TRANSITION_DURATION_MINUTES=2
# DEFAULT_TEACHING_MINUTES=90

# ---- 6. PHOTOS --------------------------------------------------------------------------------------------------------------
# The raw upload limit (the phone shrinks photos first; the server re-compresses before the AI sees them). Photos are never stored.
# MAX_IMAGE_SIZE_BYTES=15000000
# MAX_IMAGES_PER_BATCH=6

# ---- 7. SERVING AND ABUSE LIMITS (the production entry point, uvicorn app.production:app) ------------------------------------
# The folder with the built app (npm run build). Default: pwa/dist in this repository.
# PWA_DIST=
# Requests per minute / hour per address.
# RATE_LOGIN_PER_MIN=20
# RATE_REGISTER_PER_HOUR=5
# RATE_CHANGE_PIN_PER_MIN=10
# How many proxies sit in front of the app (1 for Cloud Run); the client address is read that far from the right.
# TRUSTED_PROXY_HOPS=1
# (display only)
# APP_NAME=Ankur Saathi
# APP_VERSION=0.1.0

# ---- 8. DEMO ACCOUNTS (scripts only: auth_admin.py, create_test_teachers.py; the demo holds FICTIONAL data, its PINs are published in docs/DEMO_ACCESS.md) ----
# DEMO_PIN=4826
# DEMO_ADMIN_PIN=7351
# DEMO_PRACTICE_PIN=3917

# ---- 9. THE FRONT END (a build setting, not read by the backend): in pwa/.env or on the command line ------------------------
# VITE_DEMO_HINT=false   hides the list of demo accounts on the login screen (use it for a real school)
