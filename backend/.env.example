# Ankur Saathi Backend — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# Database
DATABASE_URL=postgresql://postgres@localhost/ankur_saathi

# Claude API (required for plan generation + Vision analysis)
ANTHROPIC_API_KEY=sk-ant-...

# Claude models
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_VISION_MODEL=claude-sonnet-4-6

# Embedding API (for L2 semantic search — optional, falls back to keyword)
EMBEDDING_API_KEY=sk-...
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings

# CORS (add your PWA deployment URL)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# State for curriculum plan lookup
DEFAULT_STATE_ID=mp

# Debug mode
DEBUG=true

# ── AI budget (docs/AI_BUDGET.md) ────────────────────────────────────────────
# The hackathon credits: a fixed pool that expires on 20 Nov 2026 and must still be there when evaluators arrive.
AI_ENABLED=true
AI_ALLOCATION_USD=500                # the credit received on 15 Oct 2026. Raise it if the extra credit is granted
AI_SPEND_OFFSET_USD=3                # spent before the meter existed (an estimate; adjust it)
AI_CREDIT_EXPIRES=2026-11-20
AI_RESERVE_USD=250                   # kept back for evaluators; development cannot spend into it...
AI_RESERVE_FROM=2026-11-01           # ...until this date
AI_FINAL_MARGIN_USD=10
AI_CAP_GLOBAL_DAILY_USD=20           # the kill switch: everyone together, per India day
AI_CAP_SCHOOL_DAILY_USD=10
AI_CAP_TEACHER_DAILY_USD=3
AI_CAP_SHARED_DEMO_DAILY_USD=8       # a shared demo account is used by many reviewers
AI_PRICE_INPUT_PER_MTOK=2            # USD per million tokens: CHECK Anthropic's pricing page for your model, then run scripts/ai_usage.py calibrate
AI_PRICE_OUTPUT_PER_MTOK=10
